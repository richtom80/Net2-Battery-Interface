# Copy this file to .env and fill in real values. Never commit .env.

# Net2 SQL Server host (just the IP/hostname, no instance or port here)
DB_SERVER=192.168.0.10

# Named instance Net2's SQL Express install uses. Leave blank if you are
# using DB_PORT instead. Common Net2 default is "NET2".
DB_INSTANCE=NET2

# Only set this if you know the exact TCP port Net2's SQL instance listens
# on (e.g. because named-instance/UDP 1434 discovery is blocked by a
# firewall). Leave blank to let DB_INSTANCE resolution handle it.
DB_PORT=

# Database name. Net2 installs typically use "Net2".
DB_DATABASE=Net2

# sql  -> SQL Server login (DB_USER / DB_PASSWORD)
# ntlm -> Windows authentication (DB_DOMAIN / DB_USER / DB_PASSWORD)
DB_AUTH_TYPE=sql

DB_USER=
# Quote the password if it contains # or other special characters,
# otherwise dotenv treats everything after # as a comment.
DB_PASSWORD=""
DB_DOMAIN=

# Net2's SQL Express instance is usually self-signed / no TLS cert, so we
# trust the server cert by default for a LAN connection like this.
DB_ENCRYPT=false
DB_TRUST_SERVER_CERT=true
